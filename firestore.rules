rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "victorolayemi72@gmail.com" && request.auth.token.email_verified == true;
    }
    function isRoomPlayer(roomCode) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));
    }
    function isRoomCreator(roomCode) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(roomCode)).data.createdBy == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 250000
        && request.resource.data.avatar is string;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.category is string
        && request.resource.data.options is list && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 4;
      allow delete: if isAdmin();
    }
    match /rooms/{roomCode} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "waiting" && request.resource.data.playerCount == 1;
      allow update: if signedIn() && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["playerCount", "status"])
        && (isRoomPlayer(roomCode) || (resource.data.playerCount == 1 && request.resource.data.playerCount == 2
        && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid))));
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /players/{playerId} {
        allow read: if signedIn() && (request.auth.uid == playerId || isRoomPlayer(roomCode) || isRoomCreator(roomCode));
        allow create: if signedIn() && request.auth.uid == playerId && request.resource.data.uid == playerId
          && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2
          && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 250000;
        allow update: if signedIn() && request.auth.uid == playerId && request.resource.data.uid == playerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "photoURL", "avatar", "joinedAt"]);
        allow delete: if signedIn() && request.auth.uid == playerId;
      }
      match /roomQuestions/{questionId} {
        allow read: if isRoomPlayer(roomCode);
        allow create: if isRoomPlayer(roomCode) && isRoomCreator(roomCode)
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "waiting"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
          && request.resource.data.questionNumber is int && request.resource.data.questionNumber > 0;
        allow update: if isRoomPlayer(roomCode) && isRoomCreator(roomCode)
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "waiting"
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isRoomPlayer(roomCode) && isRoomCreator(roomCode)
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "waiting";
      }
      match /gameState/{stateId} {
        allow read: if isRoomPlayer(roomCode);
        allow create: if isRoomPlayer(roomCode) && isRoomCreator(roomCode) && stateId == "current"
          && request.resource.data.status == "playing" && request.resource.data.playerOrder is list
          && request.resource.data.playerOrder.size() == 2 && request.resource.data.questions is list
          && request.resource.data.questions.size() > 0 && request.resource.data.nextPickerUid is string;
        allow update: if isRoomPlayer(roomCode) && resource.data.nextPickerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nextPickerUid", "latestPicked"])
          && request.resource.data.questions == resource.data.questions
          && request.resource.data.playerOrder == resource.data.playerOrder
          && request.resource.data.status == resource.data.status;
        allow delete: if isAdmin();
      }
      match /pickedQuestions/{questionId} {
        allow read: if isRoomPlayer(roomCode);
        allow create: if isRoomPlayer(roomCode)
          && request.resource.data.questionId == questionId
          && request.resource.data.pickedBy == request.auth.uid
          && request.resource.data.forPlayerUid is string
          && request.resource.data.questionNumber is int
          && request.resource.data.text is string
          && get(/databases/$(database)/documents/rooms/$(roomCode)/gameState/current).data.nextPickerUid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomCode)/gameState/current).data.status == "playing";
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isRoomPlayer(roomCode);
        allow create: if isRoomPlayer(roomCode) && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.displayName is string;
        allow update, delete: if false;
      }
    }
  }
}
